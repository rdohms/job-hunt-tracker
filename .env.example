# Copy to .env (or keep a .env next to your data and launch from there).
# Real environment variables override this file.

# Where job JSON files are stored. Relative paths resolve from the directory you launch from.
DATA_DIR=./data

# Web UI port.
PORT=3000

# --- Optional: NotebookLM match scoring + cover letters (unofficial; see README) ---
# Leave NOTEBOOK_ID empty to disable these features.
NOTEBOOK_ID=
BRIDGE_PORT=8000
BRIDGE_URL=http://127.0.0.1:8000
